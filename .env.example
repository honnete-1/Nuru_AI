# Copy to .env and edit. Never commit or share .env.
DEBUG=true
# Required when DEBUG=false. Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---- Live AI (optional). Without a key, the companion runs in labelled Demo mode. ----
OPENAI_API_KEY=
# A Chat Completions model your account can use that supports JSON output.
OPENAI_MODEL=gpt-4.1-mini
# Optional: an OpenAI-compatible endpoint (leave blank for OpenAI itself).
OPENAI_BASE_URL=
AI_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=900
# Per-student daily companion requests (chat, tutoring, checks, step suggestions).
AI_DAILY_LIMIT=60
AI_DEMO_DAILY_LIMIT=80

# Verified local support text shown with safety messages, e.g. your campus counselling
# service and how to reach it. Leave blank until a person has verified it.
SUPPORT_CONTACT_TEXT=

DATABASE_PATH=db.sqlite3
# Private uploads (never inside static/). Back it up together with the database.
PRIVATE_MEDIA_ROOT=
MATERIAL_MAX_BYTES=5242880
# Default zone; each student can choose their own in Settings.
TIME_ZONE=Africa/Kigali
